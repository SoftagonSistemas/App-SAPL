{
  "name": "sapl-app-painel",
  "type": "module",
  "version": "0.0.2",
  "private": true,
  "description": "Painel de Votação Eletrônico",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test:e2e": "cypress run",
    "test:unit": "vitest",
    "lint": "eslint .",
    "build:mobile": "npm run build && npx cap copy android && cd android && gradlew assembleMobileRelease",
    "build:tv": "npm run build && npx cap copy android && cd android && gradlew assembleTvRelease",
    "build:both": "npm run build && npx cap copy android && cd android && gradlew assembleMobileRelease assembleTvRelease",
    "build:apks": "powershell -ExecutionPolicy Bypass -File build-apks.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.5",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.2",
    "@capacitor/keyboard": "^6.0.3",
    "@capacitor/preferences": "^7.0.1",
    "@capacitor/status-bar": "^6.0.2",
    "@ionic/vue": "^8.5.7",
    "@ionic/vue-router": "^8.5.7",
    "cordova-plugin-fullscreen": "^1.3.0",
    "ionicons": "^7.4.0",
    "vue": "^3.5.15",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.13.2",
    "@awesome-cordova-plugins/core": "^6.16.0",
    "@awesome-cordova-plugins/in-app-browser": "^6.16.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@vitejs/plugin-legacy": "^5.4.3",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "cordova-plugin-inappbrowser": "^6.0.0",
    "cypress": "^13.17.0",
    "eslint": "^9.27.0",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^24.1.3",
    "terser": "^5.40.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^1.6.1",
    "vue-tsc": "^2.2.10"
  }
}
